properties:
  note.Order:
    displayName: Sort
views:
  - type: table
    name: Table
    order:
      - Order
      - file.name
      - file.tags
      - Summary
    sort:
      - property: Order
        direction: ASC
      - property: file.folder
        direction: ASC
      - property: file.ext
        direction: ASC
    columnSize:
      file.name: 151
