filters:
  and:
    - file.inFolder(this.file.folder) && file.path != this.file.path
    - '!file.ext.containsAny("base", "canvas", "txt")'
    - '!file.name.containsAny("metadata", "untitled snapshot")'
    - '!file.fullname.containsAny("Notes.md", "Base.md", "note.md")'
properties:
  note.Order:
    displayName: Order
views:
  - type: table
    name: Table
    order:
      - Order
      - file.name
      - file.tags
      - notetoolbar
      - summary
    sort:
      - property: Order
        direction: ASC
      - property: file.folder
        direction: ASC
      - property: file.ext
        direction: ASC
    columnSize:
      note.Order: 50
      file.name: 227
